<resources>
    <settings>
        <setting propertyKey="@Properties.Background" title="@Strings.SetBackground">
            <settingConfig type="list">
                <listEntry value="0">@Strings.BgBlack</listEntry>
                <listEntry value="1">@Strings.BgWhite</listEntry>
            </settingConfig>
        </setting>
        <setting propertyKey="@Properties.TimeFormat" title="@Strings.SetTimeFormat">
            <settingConfig type="list">
                <listEntry value="0">@Strings.TfAuto</listEntry>
                <listEntry value="1">@Strings.Tf12</listEntry>
                <listEntry value="2">@Strings.Tf24</listEntry>
            </settingConfig>
        </setting>
    </settings>
</resources>
